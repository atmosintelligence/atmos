diff --git a/lib/ai/schedule.js b/lib/ai/schedule.js
new file mode 100644
index 0000000..1990b37
--- /dev/null
+++ b/lib/ai/schedule.js
@@ -0,0 +1,109 @@
+import Groq from 'groq-sdk';
+import { parseAiSchedule } from '@/lib/schedules';
+
+const SYSTEM_PROMPT = `You are Atmos Intelligence. Plan a weekly on/off schedule for the appliances in one room, from how the room has actually been used.
+
+Rules:
+- Appliances (TARGET): LIGHT, FAN, AC
+- Return 2-12 rules. Prefer few, clear rules over many
+- Turn things OFF shortly after the room usually empties, and ON shortly before it is usually occupied, only when the pattern is clear
+- Use only the usage summary provided. Never invent a pattern
+- Do not repeat or conflict with the rules the user already set
+- Use 24-hour local time
+- Reason: one short plain sentence, British English, under 120 characters, no emojis
+- No introduction, headings, numbering or Markdown
+
+IMPORTANT: Each rule must be a single line in EXACTLY this format:
+TARGET|ACTION|DAYS|HH:MM|Reason
+
+- ACTION: ON or OFF
+- DAYS: Daily, Weekdays, Weekends, or a comma list / range of Mon Tue Wed Thu Fri Sat Sun (e.g. Mon-Fri or Mon,Wed,Fri)
+- HH:MM: 24-hour time, e.g. 08:30
+
+Example:
+LIGHT|OFF|Mon-Fri|19:30|The room is usually empty after 19:00 on weekdays.
+/no_think`;
+
+const DAYS_ORDER = [1, 2, 3, 4, 5, 6, 0];
+const DAY_LABEL  = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MIN_DAYS   = 3;
+
+// Per weekday: the hours (local time) in which the room was occupied at least
+// half of the readings, plus how many days of data each weekday has.
+export function summariseUsage(readings, tz) {
+  const fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: '2-digit', hour12: false });
+  const buckets = new Map();
+  const days    = new Set();
+
+  for (const r of readings) {
+    const parts = fmt.formatToParts(new Date(r.timestamp));
+    const wd    = parts.find(p => p.type === 'weekday')?.value;
+    const hour  = Number(parts.find(p => p.type === 'hour')?.value) % 24;
+    if (!wd || Number.isNaN(hour)) continue;
+
+    const key = `${wd}-${hour}`;
+    const b   = buckets.get(key) ?? { n: 0, occupied: 0, power: 0 };
+    b.n += 1;
+    if (Number(r.occupancy) > 0) b.occupied += 1;
+    b.power += Number(r.power) || 0;
+    buckets.set(key, b);
+    days.add(new Date(r.timestamp).toISOString().slice(0, 10));
+  }
+
+  const lines = DAYS_ORDER.map(d => {
+    const label = DAY_LABEL[d];
+    const hours = [];
+    for (let h = 0; h < 24; h++) {
+      const b = buckets.get(`${label}-${h}`);
+      if (b && b.occupied / b.n >= 0.5) hours.push(h);
+    }
+    return `${label}: ${hours.length ? hours.map(h => `${String(h).padStart(2, '0')}:00`).join(' ') : 'no occupied hours'}`;
+  });
+
+  return { text: lines.join('\n'), daysOfData: days.size };
+}
+
+function describeRule(r) {
+  const days = r.days.map(d => DAY_LABEL[d]).join(',');
+  return `- ${r.target.toUpperCase()} ${r.action.toUpperCase()} ${days} ${r.time}`;
+}
+
+// Returns [{ target, action, days, time, reason }]. Throws if there is not enough data.
+export async function generateAISchedule({ readings, timeZone, existingRules }) {
+  const apiKey = process.env.GROQ_API_KEY;
+  if (!apiKey) throw new Error('GROQ_API_KEY not configured');
+
+  const { text, daysOfData } = summariseUsage(readings, timeZone);
+  if (daysOfData < MIN_DAYS) {
+    throw new Error(`Not enough data yet. Atmos needs at least ${MIN_DAYS} days of readings to suggest a schedule.`);
+  }
+
+  const user = [
+    `Time zone: ${timeZone}`,
+    `Days of data: ${daysOfData}`,
+    `## Occupied hours by weekday (local time)\n${text}`,
+    existingRules.length
+      ? `## Rules the user already set (do not repeat or conflict)\n${existingRules.map(describeRule).join('\n')}`
+      : '## Rules the user already set\nNone.',
+    'Return only the rule lines.',
+  ].join('\n\n');
+
+  const completion = await new Groq({ apiKey }).chat.completions.create({
+    model:    'qwen/qwen3.8-27b',
+    messages: [
+      { role: 'system', content: SYSTEM_PROMPT },
+      { role: 'user',   content: user },
+    ],
+    temperature:           0.3,
+    max_completion_tokens: 600,
+    reasoning_effort:      'none',
+    top_p:                 1,
+    stream:                false,
+  });
+
+  const message = completion.choices[0]?.message;
+  const content = message?.content?.trim() || message?.reasoning?.trim() || '';
+  if (!content) throw new Error('Empty response from model');
+
+  return parseAiSchedule(content);
+}
diff --git a/lib/alerts.js b/lib/alerts.js
new file mode 100644
index 0000000..596ab5c
--- /dev/null
+++ b/lib/alerts.js
@@ -0,0 +1,139 @@
+// Alert generation pipeline. Called by POST /api/alerts.
+// Order: cooldown → quiet hours → engine → AI → fallback to engine text → de-duplicate → save.
+
+import { getEngine } from '@/lib/server/engine';
+import { generateAIOptimizations } from '@/lib/ai/groq';
+import { GENERATION_COOLDOWN_SECONDS } from '@/lib/engine/constants.js';
+import {
+  getAlertPreferences,
+  getLastGeneratedAt,
+  getPriorAlerts,
+  getRecentAlertTitles,
+  insertAlerts,
+} from '@/lib/supabase';
+
+function isQuietHour(prefs, hour) {
+  if (!prefs?.quiet_hours_enabled) return false;
+  const { quiet_hours_start: start, quiet_hours_end: end } = prefs;
+  return start > end ? hour >= start || hour < end : hour >= start && hour < end;
+}
+
+function toIso(value) {
+  const date = value ? new Date(value) : null;
+  return date && !Number.isNaN(date.getTime()) ? date.toISOString() : null;
+}
+
+function latestTimestamp(readings) {
+  return readings.reduce((max, r) => (new Date(r.timestamp) > new Date(max) ? r.timestamp : max), readings[0].timestamp);
+}
+
+// Builds a row for the alerts table. created_at is the time of the sensor reading
+// the alert is about (generated_at is when the alert was made).
+function toAlertRow(opt, userId, deviceId, readingTime, groupTimes = {}) {
+  const group = opt.group ?? opt.group_name ?? 'General';
+  return {
+    user_id:     userId,
+    device_id:   deviceId,
+    group_name:  group,
+    severity:    opt.severity ?? 'info',
+    title:       opt.title,
+    message:     opt.message ?? opt.title,
+    explanation: opt.explanation ?? null,
+    saving_inr:  opt.saving_inr ?? (opt.saving?.inr != null ? Number.parseFloat(opt.saving.inr) : null),
+    created_at:  toIso(opt.timestamp) ?? toIso(groupTimes[group.toLowerCase()]) ?? readingTime,
+  };
+}
+
+function timesByGroup(engineOptimizations) {
+  const times = {};
+  for (const o of engineOptimizations ?? []) {
+    const group = (o.group ?? o.group_name ?? '').toLowerCase();
+    if (!group || !o.timestamp) continue;
+    if (!times[group] || new Date(o.timestamp) > new Date(times[group])) times[group] = o.timestamp;
+  }
+  return times;
+}
+
+function buildRows(optimizations, userId, deviceId, existingTitles, readingTime, groupTimes) {
+  return (optimizations ?? [])
+    .filter(opt => opt?.title && !existingTitles.has(opt.title))
+    .map(opt => toAlertRow(opt, userId, deviceId, readingTime, groupTimes));
+}
+
+// Returns { synced, source?, reason?, retryAfter? }. Throws on a database error.
+export async function syncAlerts({ userId, profile, deviceId, roomAreaM2 }) {
+  // 1. Cooldown (per user)
+  const lastAt = await getLastGeneratedAt(userId);
+  if (lastAt) {
+    const elapsed = (Date.now() - new Date(lastAt).getTime()) / 1000;
+    if (elapsed < GENERATION_COOLDOWN_SECONDS) {
+      return { synced: 0, reason: 'cooldown', retryAfter: Math.ceil(GENERATION_COOLDOWN_SECONDS - elapsed) };
+    }
+  }
+
+  // 2. Quiet hours
+  const prefs = await getAlertPreferences(userId);
+  if (isQuietHour(prefs, new Date().getHours())) {
+    return { synced: 0, reason: 'quiet_hours' };
+  }
+
+  // 3. Engine
+  const engineResult = await getEngine({
+    profile,
+    deviceId,
+    roomAreaM2,
+    thresholdOverrides: {
+      consecutiveEmpty: prefs?.min_consecutive_empty ?? 3,
+      phantomLoadHours: prefs?.phantom_load_hours    ?? 4,
+      spikeZScore:      prefs?.spike_zscore          ?? 2.5,
+      weekOverWeekPct:  prefs?.week_over_week_pct    ?? 8,
+    },
+  });
+  if (!engineResult.readings.length) return { synced: 0 };
