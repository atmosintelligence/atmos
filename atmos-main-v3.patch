diff --git a/app/api/automation/schedules/route.js b/app/api/automation/schedules/route.js
new file mode 100644
index 0000000..ab4f315
--- /dev/null
+++ b/app/api/automation/schedules/route.js
@@ -0,0 +1,88 @@
+import {
+  resolveApiUser, getSchedules, insertSchedules, updateSchedule, deleteSchedule, getAutomationLogs,
+} from '@/lib/supabase';
+import { cleanSchedule, MAX_SCHEDULES_PER_DEVICE } from '@/lib/schedules';
+
+// GET /api/automation/schedules?deviceId=ATM-001 → { schedules, logs }
+export async function GET(request) {
+  try {
+    const resolved = await resolveApiUser(request);
+    if (!resolved) return Response.json({ error: 'Unauthorized' }, { status: 401 });
+
+    const deviceId = new URL(request.url).searchParams.get('deviceId');
+    if (!deviceId) return Response.json({ error: 'deviceId required' }, { status: 400 });
+
+    const { id: userId } = resolved.user;
+    const { username }   = resolved.profile;
+    const [schedules, logs] = await Promise.all([
+      getSchedules(userId, username, deviceId),
+      getAutomationLogs(username, deviceId),
+    ]);
+    return Response.json({ schedules, logs });
+  } catch (err) {
+    return Response.json({ error: err.message }, { status: 500 });
+  }
+}
+
+// POST { deviceId, target, action, days, time, tz? } → { schedule }
+export async function POST(request) {
+  try {
+    const resolved = await resolveApiUser(request);
+    if (!resolved) return Response.json({ error: 'Unauthorized' }, { status: 401 });
+
+    const body = await request.json();
+    if (!body.deviceId) return Response.json({ error: 'deviceId required' }, { status: 400 });
+
+    const { value, error } = cleanSchedule(body);
+    if (error) return Response.json({ error }, { status: 400 });
+
+    const { id: userId } = resolved.user;
+    const { username }   = resolved.profile;
+
+    const existing = await getSchedules(userId, username, body.deviceId);
+    if (existing.length >= MAX_SCHEDULES_PER_DEVICE) {
+      return Response.json({ error: `A device can have at most ${MAX_SCHEDULES_PER_DEVICE} rules` }, { status: 400 });
+    }
+
+    const [schedule] = await insertSchedules(userId, username, body.deviceId, [{ ...value, source: 'manual' }]);
+    return Response.json({ schedule });
+  } catch (err) {
+    return Response.json({ error: err.message }, { status: 500 });
+  }
+}
+
+// PATCH { id, ...fields } → { schedule }. The rule becomes the user's own.
+export async function PATCH(request) {
+  try {
+    const resolved = await resolveApiUser(request);
+    if (!resolved) return Response.json({ error: 'Unauthorized' }, { status: 401 });
+
+    const { id, ...fields } = await request.json();
+    if (!id) return Response.json({ error: 'id required' }, { status: 400 });
+
+    const { value, error } = cleanSchedule(fields, { partial: true });
+    if (error) return Response.json({ error }, { status: 400 });
+
+    const schedule = await updateSchedule(resolved.user.id, id, value);
+    if (!schedule) return Response.json({ error: 'Rule not found' }, { status: 404 });
+    return Response.json({ schedule });
+  } catch (err) {
+    return Response.json({ error: err.message }, { status: 500 });
+  }
+}
+
+// DELETE ?id=... → { ok }
+export async function DELETE(request) {
+  try {
+    const resolved = await resolveApiUser(request);
+    if (!resolved) return Response.json({ error: 'Unauthorized' }, { status: 401 });
+
+    const id = new URL(request.url).searchParams.get('id');
+    if (!id) return Response.json({ error: 'id required' }, { status: 400 });
+
+    await deleteSchedule(resolved.user.id, id);
+    return Response.json({ ok: true });
+  } catch (err) {
+    return Response.json({ error: err.message }, { status: 500 });
+  }
+}
diff --git a/app/api/automation/suggest/route.js b/app/api/automation/suggest/route.js
new file mode 100644
index 0000000..6723c03
--- /dev/null
+++ b/app/api/automation/suggest/route.js
@@ -0,0 +1,49 @@
+import { resolveApiUser, fetchUserReadings, getSchedules, replaceAiSchedules } from '@/lib/supabase';
+import { generateAISchedule } from '@/lib/ai/schedule';
+import { isValidTimeZone, overlaps, MAX_SCHEDULES_PER_DEVICE } from '@/lib/schedules';
+
+const COOLDOWN_MS = 30_000;
+const lastRun = new Map();
+
+// POST { deviceId, tz } → { schedules, added }
+// Replaces this device's AI rules. The user's own rules are never touched.
+export async function POST(request) {
+  try {
+    const resolved = await resolveApiUser(request);
+    if (!resolved) return Response.json({ error: 'Unauthorized' }, { status: 401 });
+
+    const { deviceId, tz } = await request.json();
+    if (!deviceId) return Response.json({ error: 'deviceId required' }, { status: 400 });
+    const timeZone = isValidTimeZone(tz) ? tz : 'Asia/Kolkata';
+
+    const { id: userId } = resolved.user;
+    const { username }   = resolved.profile;
+
+    const wait = COOLDOWN_MS - (Date.now() - (lastRun.get(userId) ?? 0));
+    if (wait > 0) {
+      return Response.json({ error: `Please wait ${Math.ceil(wait / 1000)} seconds before planning again` }, { status: 429 });
+    }
+    lastRun.set(userId, Date.now());
+
+    const all    = await getSchedules(userId, username, deviceId);
+    const manual = all.filter(r => r.source === 'manual');
+
+    const readings = (await fetchUserReadings(username)).filter(r => r.device_id === deviceId);
+    const planned  = await generateAISchedule({ readings, timeZone, existingRules: manual });
+
+    const room = Math.max(0, MAX_SCHEDULES_PER_DEVICE - manual.length);
+    const rows = [];
+    for (const rule of planned) {
+      if (rows.length >= room) break;
+      if ([...manual, ...rows].some(r => overlaps(r, rule))) continue;
+      rows.push({ ...rule, tz: timeZone, source: 'ai', enabled: true });
+    }
+
+    await replaceAiSchedules(userId, username, deviceId, rows);
+    const schedules = await getSchedules(userId, username, deviceId);
+    return Response.json({ schedules, added: rows.length });
+  } catch (err) {
+    const status = /Not enough data/.test(err.message) ? 422 : 500;
+    return Response.json({ error: err.message }, { status });
+  }
+}
