    },
    {
      "name": "Alerts",
      "short_name": "Alerts",
      "description": "Recommendations waiting for you",
      "url": "/dashboard/alerts?source=shortcut",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Automation",
      "short_name": "Automation",
      "description": "Schedules and auto-off settings",
      "url": "/dashboard/automation?source=shortcut",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Devices",
      "short_name": "Devices",
      "description": "Your Atmos units and reports",
      "url": "/dashboard/devices?source=shortcut",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Subsidy Calculator",
      "short_name": "Subsidies",
